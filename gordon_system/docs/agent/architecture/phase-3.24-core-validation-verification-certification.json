  "invariant_inventory": [
    {
      "rule_id": "OWN-001",
      "name": "Unique Mutation Owner",
      "type": "ownership",
      "description": "Each entity has at most one mutation owner"
    },
    {
      "rule_id": "OWN-002",
      "name": "Owner Epoch Validity",
      "type": "ownership",
      "description": "Owner epoch must be >= current epoch"
    },
    {
      "rule_id": "HIER-001",
      "name": "No Cyclic Hierarchy",
      "type": "hierarchy",
      "description": "Entity cannot be its own ancestor"
    },
    {
      "rule_id": "DEP-001",
      "name": "No Circular Dependencies",
      "type": "dependency",
      "description": "No circular dependency chains allowed"
    },
    {
      "rule_id": "ISO-001",
      "name": "Runtime Isolation",
      "type": "isolation",
      "description": "Owner must belong to same runtime as entity"
    },
    {
      "rule_id": "LIF-001",
      "name": "Terminal State Transition",
      "type": "lifecycle",
      "description": "Terminal states cannot transition back without explicit reopening"
    },
    {
      "rule_id": "NAM-001",
      "name": "Naming Convention",
      "type": "naming",
      "description": "All entities must follow naming conventions"
    },
    {
      "rule_id": "BND-001",
      "name": "Layering Rules",
      "type": "boundary",
      "description": "Layers can only depend on layers below them"
    },
    {
      "rule_id": "CRT-001",
      "name": "Contract Implemented",
      "type": "contract",
      "description": "Every contract must have at least one implementation"
    }
  ],

