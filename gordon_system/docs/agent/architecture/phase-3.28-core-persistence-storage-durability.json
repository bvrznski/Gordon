      "Schema Evolution: Backward and forward compatible",
      "Deterministic: Same input always produces same output",
      "Canonical Encoding: One canonical encoding per object state"
    ]
  },
  
  "persistence_transactions": {
    "features": [
      {"name": "Atomic Persistence", "description": "All-or-nothing persistence operations"},
      {"name": "Commit", "description": "Atomic commit with durability guarantee"},
      {"name": "Rollback", "description": "Full rollback on failure"},
      {"name": "Compensation", "description": "Undo operations for failed transactions"},
      {"name": "Partial Failure Handling", "description": "Graceful handling of partial failures"},
      {"name": "Consistency Validation", "description": "Post-commit consistency verification"}
    ],
    "phases": ["BEGIN", "PREPARE", "[COMMIT | ABORT]", "ROLLBACK (if partial execution)"]
  },
  
  "snapshots_and_checkpoints": {
