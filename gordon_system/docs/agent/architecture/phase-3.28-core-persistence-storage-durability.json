{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gordon:phase:3.28",
  "title": "Gordon Core Phase 3.28: Persistence, Storage & Durability Architecture",
  "version": "1.0.0",
  "date": "2026-08-14",
  "status": "ACTIVE",
  
  "philosophy": {
    "persistence": {
      "definition": "Mechanism by which Gordon preserves knowledge, state, artifacts, history, identity, and runtime continuity beyond the lifetime of a single process.",
      "core_beliefs": [
        "One canonical persistence architecture exists throughout the repository",
        "Nothing persistent is anonymous; everything has identity and ownership",
        "Persistence is deterministic, reproducible, observable, recoverable, verifiable, and evolvable",
        "Runtime state, persistent state, durable objects, snapshots, checkpoints, archives, artifacts, event stores, object stores, repositories, serialization, encoding, persistence, durability, backup, recovery, synchronization, and replication are completely separate concepts"
      ]
    },
    "durability": {
      "definition": "Guarantees that data survives across failures",
      "levels": [
        {"symbol": "V", "name": "volatile", "description": "No durability guarantee"},
        {"symbol": "S", "name": "session_durable", "description": "Survives within a session"},
        {"symbol": "R", "name": "runtime_durable", "description": "Survives runtime restarts"},
        {"symbol": "P", "name": "process_durable", "description": "Survives process restarts"},
        {"symbol": "L", "name": "local_durable", "description": "Survives local failures (disk, power)"},
        {"symbol": "X", "name": "replicated_durable", "description": "Survives across replicated nodes"},
        {"symbol": "A", "name": "archival_durable", "description": "Long-term archival storage"},
        {"symbol": "M", "name": "permanent", "description": "Indefinite retention"}
      ]
    }
  },
  
  "persistence_lifecycle": {
    "phases": [
      "Created",
      "Validated",
      "Serialized",
      "Persisted",
      "Committed",
      "Indexed",
      "Available",
      "Referenced",
      "Archived (optional)",
      "Restored (optional)",
      "Compacted (optional)",
      "Retired",
      "Deleted",
      "Verified"
    ],
    "description": "Every durable object follows this canonical lifecycle. Each transition preserves integrity and provenance."
  },
  
  "storage_domains": {
    "domains": [
      {
        "name": "Runtime Store",
        "purpose": "Live runtime state",
        "durability_level": "volatile",
        "retention_policy": "none (runtime-only)",
        "ownership": "Runtime components"
      },
      {
        "name": "Configuration Store", 
        "purpose": "System configuration",
        "durability_level": "durable_local",
        "retention_policy": "indefinite",
        "ownership": "Configuration Authority"
      },
      {
        "name": "State Store",
        "purpose": "State aggregates",
        "durability_level": "durable_local",
        "retention_policy": "configurable",
        "ownership": "State Authority"
      },
      {
        "name": "Event Store",
        "purpose": "Event history",
        "durability_level": "replicated",
        "retention_policy": "configurable",
        "ownership": "Event Authority"
      },
      {
        "name": "Stream Store",
        "purpose": "Stream checkpoints",
        "durability_level": "durable_local",
        "retention_policy": "checkpoint retention",
        "ownership": "Stream Authority"
      },
      {
        "name": "Artifact Store", 
        "purpose": "Generated artifacts",
        "durability_level": "durable_local",
        "retention_policy": "versioned retention",
        "ownership": "Artifact Authority"
      },
      {
        "name": "Metadata Store",
        "purpose": "Entity metadata",
        "durability_level": "durable_local",
        "retention_policy": "indefinite",
        "ownership": "Metadata Authority"
      },
      {
        "name": "Memory Store",
        "purpose": "Cognitive memory",
        "durability_level": "process_local",
        "retention_policy": "session-based",
        "ownership": "Memory Authority"
      },
      {
        "name": "Model Store",
        "purpose": "ML models",
        "durability_level": "replicated",
        "retention_policy": "model lifecycle",
        "ownership": "Model Authority"
      },
      {
        "name": "Checkpoint Store",
        "purpose": "Execution checkpoints",
        "durability_level": "process_local",
        "retention_policy": "session duration",
        "ownership": "Checkpoint Authority"
      },
      {
        "name": "Snapshot Store",
        "purpose": "State snapshots", 
        "durability_level": "durable_local",
        "retention_policy": "snapshot policy",
        "ownership": "Snapshot Authority"
      },
      {
        "name": "Diagnostic Store",
        "purpose": "Diagnostics & metrics",
        "durability_level": "volatile",
        "retention_policy": "bounded retention",
        "ownership": "Diagnostic Authority"
      }
    ],
    "domain_ownership": {
      "owner": "Entity responsible for persistence operations",
      "policy_authority": "Defines durability and retention policies", 
      "access_control": "Controls who can read/write to the domain"
    }
  },
  
  "persistent_objects": {
    "properties": [
      {"name": "immutable_identity", "description": "Unique, immutable identifier"},
      {"name": "owner", "description": "Explicit owner entity"},
      {"name": "schema", "description": "Versioned data schema"},
      {"name": "version", "description": "Version sequence number"},
      {"name": "generation", "description": "Generation epoch number"},
      {"name": "provenance", "description": "Origin and history tracking"},
      {"name": "timestamps", "description": "Created/modified timestamps"},
      {"name": "metadata", "description": "Arbitrary metadata key-value pairs"},
      {"name": "integrity_metadata", "description": "Cryptographic integrity evidence"}
