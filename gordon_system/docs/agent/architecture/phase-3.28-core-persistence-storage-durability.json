        {"name": "Entity", "description": "Identified by immutable identity"},
        {"name": "Record", "description": "Immutable historical record"},
        {"name": "Snapshot", "description": "Point-in-time state view"},
        {"name": "Checkpoint", "description": "Execution recovery point"},
        {"name": "Archive", "description": "Long-term versioned backup"},
        {"name": "Artifact", "description": "Generated content (code, plans, docs)"},
        {"name": "Event", "description": "Historical event in event store"},
        {"name": "Transaction", "description": "Atomic persistence operation"}
      ]
    }
  },
  
  "serialization": {
    "formats": [
