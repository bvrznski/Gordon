      {
        "id": "HIGH-001",
        "title": "Priority inversion risk for dependencies",
        "description": "Low-priority tasks can block high-priority dependent tasks without priority inheritance",
        "recommendation": "Implement priority inheritance in WaitingQueue or deadlock detection"
      },
      {
        "id": "HIGH-002",
        "title": "Starvation not actively enforced",
        "description": "30-second threshold exists but no active promotion mechanism",
        "recommendation": "Implement starvation-based priority boost in run_one()"
      },
      {
        "id": "HIGH-003",
        "title": "Automatic retry not fully implemented",
        "description": "RetryPolicy configured but Scheduler does not automatically retry failed tasks",
        "recommendation": "Add retry loop in run_one() for tasks with max_attempts > 1"
      }
    ],
    "medium": [
      {
        "id": "MEDIUM-001",
        "title": "Admission integration incomplete",
        "description": "Scheduler.submit() does not validate admission receipt before accepting task",
        "recommendation": "Require AdmissionReceipt and validate in Scheduler.submit()"
      },
      {
        "id": "MEDIUM-002",
        "title": "Queue timeout not used",
        "description": "ExecutionTimeouts.queue is configured but never checked",
        "recommendation": "Check queue wait time and promote if threshold exceeded"
      },
      {
        "id": "MEDIUM-003",
        "title": "Priority inheritance incomplete",
        "description": "Only WaitingQueue.dependency_completed() implements priority inheritance",
        "recommendation": "Extend to all queue operations where dependencies are involved"
