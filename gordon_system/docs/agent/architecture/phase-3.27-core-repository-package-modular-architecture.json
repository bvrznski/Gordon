  "repository_topology": {
    "root_directory": "/home/bvrznski/Gordon",
    "zones": [
      {
        "name": "gordon_system",
        "purpose": "Primary implementation workspace",
        "subzones": [
          {"name": "docs", "purpose": "Documentation (public API)"},
          {"name": "src", "purpose": "Source code implementation zone"},
          {"name": "tests", "purpose": "Test implementations"}
