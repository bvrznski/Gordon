  "telemetry_schema": {
    "log_record": {
      "fields": [
        {"name": "level", "type": "LogLevel"},
        {"name": "message", "type": "string"},
        {"name": "context", "type": "LogContext"},
        {"name": "metadata", "type": "LogMetadata"},
        {"name": "payload", "type": "Dict[str, Any]"},
        {"name": "redacted_fields", "type": "Set[str]"},
        {"name": "is_redacted", "type": "bool"}
      ],
      "immutable": true
    },
    "log_context": {
      "fields": [
        {"name": "runtime_id", "type": "string", "required": true},
        {"name": "correlation_id", "type": "string"},
        {"name": "causation_id", "type": "string"},
        {"name": "session_id", "type": "string"},
        {"name": "request_id", "type": "string"},
        {"name": "entity_id", "type": "string"},
        {"name": "task_id", "type": "string"},
        {"name": "trace_id", "type": "string"},
        {"name": "span_id", "type": "string"}
      ]
    },
    "log_metadata": {
      "fields": [
        {"name": "source_module", "type": "string", "required": true},
        {"name": "source_function", "type": "string"},
        {"name": "source_file", "type": "string"},
        {"name": "source_line", "type": "int"},
        {"name": "thread_id", "type": "int"},
        {"name": "process_id", "type": "int"},
        {"name": "timestamp_utc", "type": "float"},
        {"name": "monotonic_time", "type": "float"}
      ]
    },
    "span_record": {
      "fields": [
        {"name": "span_id", "type": "string", "required": true},
        {"name": "trace_id", "type": "string", "required": true},
        {"name": "name", "type": "string"},
        {"name": "status", "type": "SpanStatus"},
        {"name": "start_time", "type": "float"},
        {"name": "end_time", "type": "float"},
        {"name": "parent_span_id", "type": "string"},
        {"name": "child_span_ids", "type": "List[str]"},
        {"name": "attributes", "type": "Dict[str, str]"},
        {"name": "events", "type": "List[SpanEvent]"}
      ],
      "immutable": true
    },
    "metric_point": {
      "fields": [
        {"name": "name", "type": "string", "required": true},
        {"name": "value", "type": "float"},
        {"name": "timestamp_utc", "type": "float"},
        {"name": "labels", "type": "Dict[str, str]"},
        {"name": "metric_type", "type": "MetricType"}
      ],
      "immutable": true
    },
    "health_report": {
      "fields": [
        {"name": "report_id", "type": "string", "required": true},
        {"name": "subject", "type": "string"},
        {"name": "timestamp_utc", "type": "float"},
        {"name": "states", "type": "Dict[str, HealthStatus]"},
        {"name": "aggregate_state", "type": "HealthStatus"}
      ],
      "immutable": true
    }
  },
  "metrics_inventory": {
    "metric_types": [
      {"name": "COUNTER", "description": "Monotonically increasing count", "characteristics": ["always increases", "reset on restart"]},
      {"name": "GAUGE", "description": "Current value that can go up or down", "characteristics": ["fluctuates", "instantaneous reading"]},
