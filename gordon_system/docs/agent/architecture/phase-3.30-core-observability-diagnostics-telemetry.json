{
  "phase": {
    "version": "3.30",
    "title": "Core Observability, Diagnostics & Telemetry Architecture",
    "status": "IMPLEMENTED",
    "date": "2026-08-14"
  },
  "observability_taxonomy": {
    "concepts": [
      {
        "name": "Observability",
        "definition": "Architectural capability that enables Gordon to understand its own operation, explain behavior, diagnose failures, measure performance, reconstruct execution, and support autonomous improvement"
      },
      {
        "name": "Diagnostics",
        "definition": "Process of identifying and explaining failures or unusual states in the runtime"
      },
      {
        "name": "Telemetry",
        "definition": "Transport mechanism for observability data from source to destination"
      },
      {
        "name": "Tracing",
        "definition": "Reconstruction of execution flow through span hierarchies and correlation"
      },
      {
        "name": "Logging",
        "definition": "Structured recording of events with full context, never the primary debugging mechanism"
      },
      {
        "name": "Metrics",
        "definition": "Quantitative measurements collected deterministically over time"
      }
    ],
    "distinguishing_characteristics": [
      {
        "concept": "Observability",
        "vs_Monitoring": "Focuses on understanding WHY things happen, not just alerting on WHEN",
        "vs_Logging": "Integrates logs with traces and metrics for full context",
        "vs_Telemetry": "The architecture; telemetry is the transport mechanism"
      }
    ]
  },
