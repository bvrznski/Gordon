  "backoff_strategies": [
    {
      "name": "CONSTANT",
      "description": "Fixed delay between retries",
      "formula": "delay = min(initial_delay, maximum_delay)"
    },
    {
      "name": "LINEAR",
      "description": "Delay increases linearly with each attempt",
      "formula": "delay = initial_delay * (attempt + 1), capped at maximum_delay"
    },
    {
      "name": "EXPONENTIAL",
      "description": "Delay doubles each retry (recommended default)",
      "formula": "delay = initial_delay * multiplier^attempt, capped at maximum_delay"
    },
    {
      "name": "JITTERED_EXPONENTIAL",
      "description": "Exponential with randomization to prevent thundering herd",
      "formula": "base_delay + random_jitter where jitter_range is ±10% of base_delay"
    },
    {
      "name": "BOUNCED_BACKOFF",
      "description": "Alternate between minimum and maximum delays",
      "formula": "if attempt % 2 == 0: min_delay else: max_delay"
    }
